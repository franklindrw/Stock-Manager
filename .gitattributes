# Define o comportamento padrão do Git para normalizar line endings
* text=auto eol=lf

# Força LF para arquivos específicos
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.toml text eol=lf

# Arquivos binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
